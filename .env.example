# ===========================================
# ZhiYu Environment Variables Template
# ===========================================
# Copy this file to .env and fill in your own values.
# NEVER commit .env to git.

# -------------------------------------------
# Backend Server
# -------------------------------------------
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:8080,http://127.0.0.1:8080
# Cloudflare Pages 每次部署都会生成随机子域（ab1bc852.zhiyu-cloud.pages.dev），
# 没法逐个写进 ALLOWED_ORIGINS，用正则匹配整个站点及其所有预览子域。
ALLOWED_ORIGIN_REGEX=https://([a-z0-9-]+\.)?zhiyu-cloud\.pages\.dev
DATABASE_PATH=/data/zhiyu.db
# 留空则使用上面的 SQLite；填 Postgres 时请务必使用 Supabase 的
# Shared Pooler 地址（直连地址在免费版是 IPv6-only，容器连不上）。
# 格式：postgresql://postgres.<项目ID>:<密码>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
# 连接数据库的超时秒数
DATABASE_CONNECT_TIMEOUT=10

# -------------------------------------------
# Supabase Storage (Original PDF / Word Files)
# -------------------------------------------
# When enabled, original uploaded files are stored in Supabase Storage.
# The database keeps only the file URL/path, parsed text chunks, and logs.
USE_SUPABASE_STORAGE=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents
SUPABASE_STORAGE_PREFIX=documents
SUPABASE_STORAGE_PUBLIC=false
SUPABASE_STORAGE_TIMEOUT=120

# -------------------------------------------
# PostgreSQL Container
# -------------------------------------------
POSTGRES_DB=zhiyu
POSTGRES_USER=zhiyu
POSTGRES_PASSWORD=change_this_password

# -------------------------------------------
# Frontend (Browser API Base URL)
# -------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# -------------------------------------------
# Tencent Hunyuan LLM
# -------------------------------------------
HUNYUAN_API_KEY=
HUNYUAN_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
HUNYUAN_MODEL=hunyuan-lite

# -------------------------------------------
# Embedding Retrieval
# -------------------------------------------
# Uses an OpenAI-compatible /embeddings endpoint.
# Leave EMBEDDING_API_KEY blank to reuse HUNYUAN_API_KEY.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
EMBEDDING_MODEL=
USE_EMBEDDING_RETRIEVAL=false
EMBEDDINGS_AUTO_INDEX=false
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MIN_SIMILARITY=0.15

# -------------------------------------------
# Dify Dataset Retrieval
# -------------------------------------------
DIFY_API_URL=http://localhost:3000/v1
DIFY_API_KEY=
DIFY_DATASET_ID=
USE_DIFY_RETRIEVAL=false

# -------------------------------------------
# RAGFlow Retrieval
# -------------------------------------------
RAGFLOW_API_URL=http://localhost:9380/api/v1
RAGFLOW_API_KEY=
RAGFLOW_KB_ID=
USE_RAGFLOW_RETRIEVAL=false
